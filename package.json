{
  "name": "dsh-decision-effect-proof",
  "version": "0.1.1",
  "description": "Content-addressed proof that recorded DSH authorization decisions and effects agree",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./proof": "./lib/decision-effect-proof.mjs"
  },
  "bin": {
    "dsh-decision-effect-proof": "./bin/dsh-decision-effect-proof.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "bin/",
    "cordis.patch.yml",
    "examples/decision-effects.json",
    "index.js",
    "lib/",
    "mcp-server.mjs",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-alpha.4",
      "node": ">=22",
      "dshReleases": {
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:plugin": "node test/plugin-smoke.mjs",
    "smoke:mcp": "node test/mcp-smoke.mjs",
    "smoke:dsh": "node test/dsh-runtime-smoke.mjs",
    "smoke:stock-web": "node test/stock-web-loader-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/dsh-decision-effect-proof.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "authorization",
    "effect",
    "evidence"
  ]
}
